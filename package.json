{
    "name":  "youtube-music-desktop",
    "version":  "1.0.0",
    "description":  "YouTube Music Desktop App - Modular \u0026 Scalable Architecture",
    "author":  "YouTube Music Desktop",
    "main":  "src/main/index.js",
    "scripts":  {
                    "start":  "electron .",
                    "dev":  "electron .",
                    "build":  "electron-builder --win"
                },
    "build":  {
                  "appId":  "com.ytmusic.desktop",
                  "productName":  "YouTube Music",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "src/**/*",
                                "assets/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ],
                              "icon":  "assets/icon.ico"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "installerIcon":  "assets/icon.ico",
                               "uninstallerIcon":  "assets/icon.ico",
                               "installerHeaderIcon":  "assets/icon.ico",
                               "shortcutName":  "YouTube Music",
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "include":  "build/installer.nsh"
                           }
              },
    "dependencies":  {
                         "@ghostery/adblocker-electron":  "^2.18.2",
                         "cross-fetch":  "^4.1.0"
                     },
    "devDependencies":  {
                            "electron":  "^40.8.0",
                            "electron-builder":  "^26.15.3"
                        }
}
