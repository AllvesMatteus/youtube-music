# ===================================================================
# YOUTUBE MUSIC DESKTOP - EXEMPLO DE VARIAVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seu token pessoal.
# O arquivo .env esta no .gitignore e nunca deve ser commitado.
# ===================================================================

# GitHub Personal Access Token (classic com escopo 'repo')
GH_TOKEN=seu_github_token_aqui

# Repositorio GitHub
GITHUB_OWNER=AllvesMatteus
GITHUB_REPO=youtube-music

# Ambiente
NODE_ENV=production
